# AuthKey-ESP32 secrets. Copy to .env (git-ignored) and fill in.
# Read at build time by scripts/env_secrets.py.

# WiFi networks imported into the device on first boot (or after `wifi reset`).
# Add more as WIFI_3_..., WIFI_4_... More can also be added later over the
# serial console: wifi add <ssid> <password>
WIFI_1_SSID=MyHomeWiFi
WIFI_1_PASSWORD=password
WIFI_2_SSID=
WIFI_2_PASSWORD=

# Over-the-air firmware updates (pio run -e ota -t upload). Leave empty to
# disable OTA: anyone who can flash the firmware can read every key on the
# device, so use a long random password if you enable it.
OTA_PASSWORD=
# Device address for OTA uploads.
OTA_HOST=authkey-esp32.local

# IITG captive-portal (agnigarh FortiGate) auto-login + keepalive. Leave both
# empty to disable. The device logs in by itself and refreshes the session so
# its internet (NTP, FIDO tunnel) stays up without a browser.
IITG_USERNAME=
IITG_PASSWORD=
