# AuthKey-ESP32 secrets. Copy to .env (git-ignored) and fill in.
# Read at build time by scripts/env_secrets.py.

# WiFi networks imported into the device on first boot (or after `wifi reset`).
# Add more as WIFI_3_..., WIFI_4_... More can also be added later over the
# serial console: wifi add <ssid> <password>
WIFI_1_SSID=MyHomeWiFi
WIFI_1_PASSWORD=password
WIFI_2_SSID=
WIFI_2_PASSWORD=

# Over-the-air firmware updates (pio run -e ota -t upload). Leave empty to
# disable OTA: anyone who can flash the firmware can read every key on the
# device, so use a long random password if you enable it.
OTA_PASSWORD=
# Device address for OTA uploads.
OTA_HOST=authkey-esp32.local

# IITG captive-portal (agnigarh FortiGate) auto-login + keepalive. Leave both
# empty to disable. The device logs in by itself and refreshes the session so
# its internet (NTP, FIDO tunnel) stays up without a browser.
IITG_USERNAME=
IITG_PASSWORD=

# Telegram bot for waking the Proxmox server (/wake, /status, /autowake).
# Token from @BotFather. TELEGRAM_CHAT_ID: your numeric chat ID (several
# allowed, comma-separated); only these chats get answers. Leave it empty at
# first: the device then logs the chat ID of every message it receives (serial
# and the event log), so you can copy yours here and re-flash.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Wake-on-LAN machines, imported on first boot or `wol reset` (more can be
# added later from Telegram /addhost, the web page or `wol add`). IP and
# ports are for status checks; BROADCAST is optional (directed broadcast of
# the machine's subnet). Without any WOL_ lines the built-in "pve" is used.
WOL_1_NAME=pve
WOL_1_MAC=64:00:6a:2b:36:9f
WOL_1_IP=172.16.114.175
WOL_1_PORTS=8006,22
WOL_1_BROADCAST=172.16.119.255
# Weekly maintenance windows (optional, up to 2, ";"-separated): the AuthKey
# wakes the machine 5 min before if it is off, stays quiet about restarts
# inside the window and reports when it ends. Days: sun..sat, sat,sun,
# mon-fri, daily, weekend; start in local time; length in minutes (or 2h).
# Also settable later: Telegram /maint, the web page, `wol maint`.
WOL_1_MAINT=sat 00:00 120; sun 00:00 120

# Proxmox VE API (optional): /pve status, guests, backups, updates, shutdown /
# reboot and VM power from Telegram, plus backup / update results after each
# maintenance window. Create an API token in Proxmox (Datacenter ->
# Permissions -> API Tokens) and give it a role (see README: Proxmox).
# PROXMOX_TOKEN_ID is user@realm!tokenid, PROXMOX_TOKEN its secret (UUID).
PROXMOX_TOKEN_ID=root@pam!esp32
PROXMOX_TOKEN=
# The API address on the LAN (the AuthKey connects here directly).
PROXMOX_HOST_IP=172.16.114.175
PROXMOX_HOST_PORT=8006
# Optional: the wake-on-LAN machine this server is (default: the one with
# PROXMOX_HOST_IP, else the first); the node name (default: asked from the
# API); the certificate's SHA-256 fingerprint (default: pinned on the first
# connection); a web UI link shown in Telegram (e.g. a tunnel URL).
PROXMOX_HOST=
PROXMOX_NODE=
PROXMOX_FINGERPRINT=
PROXMOX_HOST_URL=
# More Proxmox servers: the same keys as PVE_2_TOKEN_ID, PVE_2_TOKEN, ...
